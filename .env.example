# Copia este archivo como .env y llena los valores. El .env nunca se sube a Git.
# Variables que va a usar la API (documento de diseño, ADR-001). La HU-03 todavía no usa ninguna.

# Puerto de la API Express
PORT=

# Conexión a PostgreSQL
DATABASE_URL=

# Clave del servicio de IA que clasifica las solicitudes (solo la usa la API, nunca la PWA)
IA_API_KEY=
